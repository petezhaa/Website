{
  "$schema": "node_modules/wrangler/config-schema.json",
  // same name as the existing (failed) dashboard worker so we replace it
  "name": "petezhaa",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    // canonical domain
    { "pattern": "petezha.xyz", "custom_domain": true },
    // aliases; the app 308-redirects them to petezha.xyz
    { "pattern": "peterwzhao.com", "custom_domain": true },
    { "pattern": "www.peterwzhao.com", "custom_domain": true },
    { "pattern": "www.petezha.xyz", "custom_domain": true }
  ],
  "kv_namespaces": [
    // the daily-challenge leaderboard
    { "binding": "LEADERBOARD", "id": "7852cf36d91d4467a144a1f23cad3954" },
    // OpenNext's ISR/fetch cache — without it every visit re-renders the
    // page and refetches Letterboxd/Steam/GitHub live
    { "binding": "NEXT_INC_CACHE_KV", "id": "813fe64247f649aa9304164f6368ac93" }
  ],
  "observability": {
    "enabled": true
  }
}
